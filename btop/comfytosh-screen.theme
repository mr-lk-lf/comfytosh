theme[main_fg]="#d6e8c8"
theme[title]="#d6e8c8"
theme[hi_fg]="#ff773d"
theme[selected_bg]="#364c3f"
theme[selected_fg]="#d6e8c8"
theme[inactive_fg]="#bac1b8"
theme[graph_text]="#bac1b8"
theme[meter_bg]="#3c4641"
theme[proc_misc]="#7fcfd4"
theme[cpu_box]="#8fb3dd"
theme[mem_box]="#7cd3a2"
theme[net_box]="#b9a3d9"
